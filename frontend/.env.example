# Closr / OPERA AI Environment Configuration
# Set the backend API base URL when connecting to a live backend service.
# If omitted or empty, the application runs in local development/demo mode with mock services.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Required Backend Endpoints Specification:
# POST   /api/v1/auth/patient/signup         - Register new patient (name, email, phone, password)
# POST   /api/v1/auth/patient/login          - Patient login (email, password) -> sets HttpOnly cookie or token
# POST   /api/v1/auth/admin/login            - Admin/staff login (email, password) -> returns user with role
# POST   /api/v1/auth/forgot-password        - Password recovery request (email, portal)
# POST   /api/v1/auth/reset-password         - Password reset execution (token, newPassword)
# POST   /api/v1/auth/logout                 - Invalidate session / refresh token
# GET    /api/v1/auth/me                     - Retrieve current authenticated session profile
