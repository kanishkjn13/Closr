# ==============================================================================
# CLOSR / OPERA AI Backend - Environment Configuration Template
# Copy this file to .env and adjust variables for local development or production.
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,your-service-name.onrender.com

# Database Option A: Cloud MySQL Connection URL (Render / Aiven / Railway / TiDB Cloud)
# e.g., mysql://user:password@host:port/database_name
# DATABASE_URL=mysql://avnadmin:password@mysql-instance.aivencloud.com:12345/defaultdb

# Database Option B: Discrete Parameters (Local or Remote MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=closr_db
DB_USER=closr_user
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: Disable SSL if using local non-SSL MySQL (true for local dev, false for cloud)
DB_SSL_DISABLED=true

# For SQLite Local Dev (leave uncommented if running without MySQL):
# DB_ENGINE=django.db.backends.sqlite3

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated for frontend integration)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://closr-liart.vercel.app
